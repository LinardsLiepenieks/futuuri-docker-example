# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres

############
# API Proxy
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# API
############

PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth
############

## General
SITE_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Missing variables that were causing warnings
SUPABASE_PUBLIC_URL=http://localhost:8000
ENABLE_ANONYMOUS_USERS=false

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your_mail_user
SMTP_PASS=your_mail_password
SMTP_SENDER_NAME=mail

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

############
# Functions
############
FUNCTIONS_VERIFY_JWT=false

############
# Logs & Analytics
############
LOGFLARE_LOGGER_BACKEND_API_KEY=your-super-secret-and-long-logflare-key
LOGFLARE_API_KEY=your-super-secret-and-long-logflare-key
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-logflare-private-token-here
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-logflare-public-token-here

############
# Realtime & Pooler Secrets
############
SECRET_KEY_BASE=your-secret-key-base-here-must-be-at-least-64-characters-long-12345
VAULT_ENC_KEY=your-vault-encryption-key-here-32-chars

############
# Storage
############
STORAGE_BACKEND=file
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_S3_BUCKET=stub
STORAGE_S3_REGION=stub
STORAGE_S3_ENDPOINT=stub
STORAGE_S3_FORCE_PATH_STYLE=stub
STORAGE_S3_ACCESS_KEY_ID=stub
STORAGE_S3_SECRET_ACCESS_KEY=stub
GLOBAL_S3_BUCKET=stub

############
# Metrics
############
ENABLE_ANALYTICS=true

############
# Pooler
############
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10
POOLER_TENANT_ID=tenant1
POOLER_PROXY_PORT_SESSION=5432
POOLER_PROXY_PORT_TRANSACTION=6543

############
# Realtime
############
REALTIME_CHANNELS_PER_CLIENT=1000

############
# Edge Runtime
############
EDGE_RUNTIME_IMAGE=supabase/edge-runtime:v1.69.6

############
# Vector & Docker
############
VECTOR_CONFIG_FILE=/etc/vector/vector.yaml
DOCKER_SOCKET_LOCATION=/Users/macpro/.docker/run/docker.sock

############
# Webhooks
############
WEBHOOKS_LOG_LEVEL=info
WEBHOOKS_RETRIES=3

############
# ImgProxy
############
IMGPROXY_ENABLE_WEBP_DETECTION=true